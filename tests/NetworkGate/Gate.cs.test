using TeamModVersions;

// Compile this file only in NetworkGate, not in the enclosing OfflineTests SDK wildcard.
internal static class Gate
{
    internal static void Check(bool ok,string why) { if (!ok) throw new Exception(why); }
    private sealed class World
    {
        internal ulong[] Members = {1,2,3,4}; internal ulong Lobby = 111; internal uint Session = 55;
        internal int Frame; internal uint Clock => 1000+(uint)Frame/60; internal float Now => Frame/60f;
        internal readonly Dictionary<ulong,string> Data = new();
        internal readonly Dictionary<ulong,Client> Clients = new();
        internal Client Add(ulong id) => Clients[id] = new(this,id);
        internal void Run(int stop,Func<Client,bool> open)
        {
            for (;Frame<stop*60;Frame++) foreach (var c in Clients.Values.Where(c => c.On)) c.Service.Tick(Now,open(c));
        }
    }
    private sealed class Client : INetworkIO
    {
        internal readonly NetworkService Service; internal readonly ulong Id; private readonly World w;
        internal bool On = true; private ulong epoch;
        internal int Queries, Reads, Writes, Polls, Pulses, ReportsBytes, PulseBytes, Rosters;
        internal bool Blind, Opaque, Frozen, Trickle, Game, Host, HostZero, HostTrickle;
        internal int HostPolls;
        internal int? GamePing;
        internal readonly Dictionary<ulong,float> LastQuery = new(), LastSend = new();
        private readonly Queue<(int Ready, ulong From,byte[] Bytes)> inbox = new();
        internal Client(World world,ulong id) { w=world; Id=id; epoch=id*100; Service=new(this); }
        public ulong NewEpoch() => ++epoch;
        public NetworkRoster Roster() { Rosters++; return new(new(w.Lobby,w.Session,Id),w.Members,w.Clock); }
        public (int,int) Inspect(ulong id, bool compatible)
        {
            Check(w.Members.Contains(id) && id != Id,"queried non-member"); Limit(LastQuery,id); Queries++;
            if (Blind) return (0,-1); // test knob: peer present in roster but unreachable
            if (!compatible) return NetworkLink.CachedEstimate(GamePing ?? (int)(20*Id+id));
            return id == 4 && Id == 2 ? (0,-1) : (id==3 ? 2 : 1,(int)(20*Id+id));
        }
        private void Limit(Dictionary<ulong,float> map,ulong id)
        { if (map.TryGetValue(id,out float old)) Check(w.Now-old >= 1,"per-peer burst"); map[id]=w.Now; }
        // Opaque = no observed payload coverage yet; Frozen = measured zero.
        // Opaque = no observed payload coverage yet; Frozen = measured zero.
        // Trickle a real but tiny non-zero rate that must not format as 0. Game = the same traffic seen at
        // the game's own transport entry points instead of the Steam wrappers.
        public NetworkTotal PayloadTotals() => Opaque ? new(-1,-1,NetworkSource.None) :
            Frozen ? new(0L,0L,Source) : Trickle ? new(w.Frame/6L,w.Frame/6L,Source) :
            new(w.Frame*1024L*(long)Id,2*w.Frame*1024L*(long)Id,Source);
        private NetworkSource Source => Game ? NetworkSource.Game : NetworkSource.Steam;
        // A separate meter: this machine's interfaces. Only asked for when the process meter is blind.
        public NetworkTotal HostTotals()
        {
            HostPolls++;
            if (!Host) return new(-1,-1,NetworkSource.None);
            long n = HostZero ? 1000 : HostTrickle ? w.Frame*10L : w.Frame*4096L;
            return new(n,2*n,NetworkSource.Host);
        }
        public string? Read(NetworkScope s,ulong author) { Reads++; return w.Data.GetValueOrDefault(author); }
        public void Write(NetworkScope s,string value)
        { Check(value.Length <= 132,"large report"); Writes++; ReportsBytes+=value.Length; w.Data[Id]=value; }
        public bool Send(ulong id,byte[] bytes)
        {
            Check(w.Clients.ContainsKey(id) && w.Members.Contains(id),"sent to nonparticipant");
            Check(w.Data.TryGetValue(id,out var ad) && ad!="-","sent without advertisement");
            Limit(LastSend,id); Pulses++; PulseBytes+=bytes.Length;
            Check(NetworkWire.Decode(bytes,out var p) && p.ToEpoch == w.Clients[id].epoch,"unbound pulse");
            // Different delay/loss on the two directions of the very same link.
            if (!(Id==1 && id==2 && p.Seq%5==0)) w.Clients[id].inbox.Enqueue((w.Frame+(int)(Id+id+p.Seq%3),Id,bytes));
            return true;
        }
        public bool Receive(out ulong peer,out byte[] bytes)
        {
            Polls++; peer=0; bytes=Array.Empty<byte>();
            if (!inbox.TryPeek(out var pkt) || pkt.Ready>w.Frame) return false;
            inbox.Dequeue(); peer=pkt.From; bytes=pkt.Bytes; return true;
        }
        internal string Text(ulong observer)
        {
            var a=Service.Lines(observer,i=>$"<b>P{i}</b>\n");
            Check(a.Length<=14 && a.All(x=>!x.Contains('<')&&!x.Contains('\n')),"unsafe/oversize lines");
            return string.Join("|",a);
        }
    }
    private static void Budget(string mode,int installs)
    {
        var w=new World(); // player 4 is the unmodified host in mixed/solo cases
        for (ulong i=1;i<=(ulong)installs;i++) w.Add(i);
        w.Run(60,c=> mode=="open" || mode=="mixed" && c.Id==1);
        int n=0,bytes=0,msg=0,reads=0,writes=0,polls=0,cache=0,history=0;
        foreach(var c in w.Clients.Values)
        {
            bool open=mode=="open" || mode=="mixed" && c.Id==1;
            Check(c.Queries==(open?180:36) && c.Reads==c.Queries,"per-client query/read budget");
            Check(c.Writes==(open?15:12) && c.Pulses<=c.Queries && c.ReportsBytes<=c.Writes*132 && c.PulseBytes==c.Pulses*52,"byte/message budget");
            Check(c.Polls<= (open?1200:300)+180 && c.Service.CacheCount==3 && c.Service.MaxHistory<=60,"poll/cache budget");
            Check(c.HostPolls==0,"host meter polled while the process meter works");
            Check(c.Text(c.Id).Contains($"接收 {60*c.Id} KiB/s　发送 {120*c.Id} KiB/s"),"local Rx/Tx units");
            var shownCells=new string[4,HudCard.Rows];
            Check(HudCard.Fill(c.Service.Lines(0,i=>$"P{i}"),true,shownCells,0)==5 && shownCells[0,0].Contains("本机") && shownCells[0,1].Contains("收"),"zero click HUD: current observer and all three links");
            if(installs==1) Check(shownCells[0,2].Contains("采样时间未知"),"cached estimates retain provenance in visible card");
            foreach(var r in w.Clients.Values.Where(r=>r!=c))
            {
                if (c.Id==1 && r.Id==2) Check(c.Text(c.Id).Contains("应用波动") && c.Text(c.Id).Contains("往返 0–"),"probe range and application variation explicitly labeled");
                var text=c.Text(r.Id);
                Check(text.Contains("来源：队友大厅报告") && text.Contains($"该端接收 {60*r.Id} KiB/s"),"observer/source attribution");
                HudCard.Fill(c.Service.Lines(r.Id,i=>$"P{i}"),false,shownCells,1);
                Check(shownCells[1,0].Contains("队友大厅报告") && shownCells[1,1].Contains($"收 {60*r.Id}"),"rendered remote card does not borrow local payload");
            }
            n+=c.Queries; reads+=c.Reads; writes+=c.Writes; polls+=c.Polls; bytes+=c.PulseBytes+c.ReportsBytes; msg+=c.Pulses; cache+=c.Service.CacheCount; history=Math.Max(history,c.Service.MaxHistory);
        }
        if(installs>=2)
        {
            var c=w.Clients[1]; var roster=new NetworkRoster(new(w.Lobby,w.Session,2),w.Members,w.Clock);
            Check(NetworkWire.Decode(w.Data[1],roster,1,out var report),"outgoing wire");
            var e=report.Edges.Single(e=>e.Peer==2);
            Check(e.Route==1 && e.Rtt is >0 and <1000 && e.Jitter>=0 && e.Rx==0 && e.Tx>0,"real service: directional pulse RTT/jitter/loss");
        }
        if(installs<4) Check(w.Clients[1].Text(4).Contains("无新鲜的队友报告") && w.Clients[1].Text(1).Contains("游戏估值"),"unmodified host fallback");
        if(installs==1) Check(msg==0 && polls==0,"solo must never probe or poll");
        Console.WriteLine($"60s {mode,-6} {installs}/4: queries={n}, memberReads={reads}, reports={writes}, pulses={msg}, payloadBytes={bytes}, polls={polls}, peersCached={cache}, maxHistory={history}");
    }
    private static void Rejection()
    {
        var w=new World(); var c=w.Add(1); var other=w.Add(2); w.Run(12,_=>true);
        var old=w.Data[2]; w.Run(18,_=>true); var latest=w.Data[2]; other.On=false;
        Check(c.Text(2).Contains("队友大厅报告"),"no fresh baseline");
        w.Data[2]=old; w.Run(20,_=>true); Check(c.Text(2).Contains("无新鲜"),"accepted replay");
        w.Data[2]=latest; w.Run(21,_=>true); Check(c.Text(2).Contains("无新鲜"),"revived rejected sequence");
        w.Data[2]="!!!"; w.Run(22,_=>true); Check(c.Text(2).Contains("无新鲜"),"malformed");
        other.On=true; w.Run(29,_=>true); Check(c.Text(2).Contains("队友大厅报告"),"failed to recover");
        other.On=false; w.Run(48,_=>true); Check(c.Text(2).Contains("无新鲜"),"stale identical report was renewed");
        int sent=c.Pulses; w.Run(53,_=>true); Check(c.Pulses==sent,"stale probe");
        w.Members=new ulong[]{1,3,4}; w.Run(54,_=>true); Check(c.Service.CacheCount==2 && c.Text(2).Contains("已离开"),"leave cleanup");
        w.Members=new ulong[]{1,2,3,4}; w.Run(55,_=>true); Check(c.Text(2).Contains("无新鲜"),"rejoin replay");
        other.On=true; w.Run(63,_=>true); var prior=w.Data[2]; w.Session++; other.On=false; w.Run(64,_=>true);
        Check(c.Text(2).Contains("无新鲜"),"session rollover"); w.Lobby++; w.Data[2]=prior; w.Run(65,_=>true);
        Check(c.Text(2).Contains("无新鲜"),"lobby rollover");
        c.Service.Reset(); Check(c.Service.CacheCount==0 && w.Data[1]=="-","reset/withdraw");
        w.Members=new ulong[]{2,3,4}; w.Run(66,_=>true); Check(c.Service.CacheCount==0,"missing self");
        w.Members=new ulong[]{1,1,2}; w.Run(67,_=>true); Check(c.Service.CacheCount==0,"duplicate roster");
    }
    private static void WireAndMath()
    {
        var author=new NetworkScope(111,55,2); var roster=new NetworkRoster(author with {Self=1},new ulong[]{1,2,3,4},1050);
        var edge=new NetworkEdge(1,1,80,12,10,20); var r=new NetworkReport(456,1049,500,1000,new[]{edge});
        bool Ok(NetworkReport p) => NetworkWire.Decode(NetworkWire.Encode(author,p),roster,2,out _);
        Check(Ok(r) && !Ok(r with {Issued=1051}) && !Ok(r with {Issued=1030}) && !Ok(r with {Epoch=0}) && !Ok(r with {InRate=-2}),"report scalar validation");
        foreach(var e in new[]{edge with {Peer=8},edge with {Peer=2},edge with {Jitter=-9},edge with {Rx=1001},edge with {Route=9},edge with {Age=16}})
            Check(!Ok(r with {Edges=new[]{e}}),"invalid report edge");
        Check(!Ok(r with {Edges=new[]{edge,edge}}),"duplicate edge");
        var text=NetworkWire.Encode(author,r);
        foreach(var bad in new[]{text+new string('x',2000),"",text[1..],NetworkWire.Encode(author with {Lobby=112},r),NetworkWire.Encode(author with {Session=56},r),NetworkWire.Encode(author with {Self=3},r)})
            Check(!NetworkWire.Decode(bad,roster,2,out _),"malformed/envelope");
        var link=new NetworkLink(); link.Sent(1,0); var p=new NetworkPulse(111,55,2,1,3,1,700,100);
        link.Receive(p,0.75); var a=link.Edge(2,1,-1,1); Check(a.Rtt==50 && a.Jitter==-1,"residence subtraction");
        link.Sent(2,1); link.Receive(p with {Seq=4,Ack=2,HoldMs=675},1.75); link.Receive(p with {Seq=4,Ack=2,HoldMs=0},1.76);
        a=link.Edge(2,1,-1,2); Check(a.Rtt==75 && a.Jitter==25 && a.Tx==100,"echo replay/jitter math");
        link.Receive(p with {Seq=7,Ack=2},3); Check(link.Edge(2,1,-1,3).Rx==400,"missing incoming sequence");
        Check(link.Edge(2,1,-1,25).Rtt==-1 && link.Edge(2,1,-1,25).Rx==-1,"old measurements");
        link.Sent(3,25); link.Receive(p with {Seq=8,Ack=3,HoldMs=100},25.15); Check(link.Edge(2,1,-1,26).Jitter==-1,"gap starts a new jitter segment");
        link.Route(2); Check(link.Edge(2,2,-1,26).Rtt==-1,"route change clears old ACKs");
        var wrongVersion=Convert.FromBase64String(text); wrongVersion[3]=(byte)'1';
        Check(NetworkWire.Key!="tmv.net1" && !NetworkWire.Decode(Convert.ToBase64String(wrongVersion),roster,2,out _),"fresh v1 declaration is not compatible");
        var tw=new World(); var only=tw.Add(1); tw.Run(20,_=>true);
        Check(only.Text(1).Contains("游戏估值") && only.Text(1).Contains("采样时间未知") && !only.Text(1).Contains("） 往返"),"frozen local game estimate is not fresh directional RTT");
        var asPeer=new NetworkRoster(new(tw.Lobby,tw.Session,4),tw.Members,tw.Clock);
        Check(NetworkWire.Decode(tw.Data[1],asPeer,1,out var estReport) && estReport.Edges.All(e=>e.Rtt<0),"do not publish unsourced game estimates as links");
        // Same 20ms wire RTT, different time spent waiting before each receiver polls.
        foreach (int wait in new[]{0,50,200,390}) { var l=new NetworkLink(); l.Sent(1,0); l.Receive(p with {HoldMs=250},(.270+wait/1000.0));
            var m=l.Edge(2,1,-1,1); Check(m.Rtt==20+wait && 20<=m.Rtt+1,"poll phase changes the upper bound, not the true wire latency"); }
    }
    private static int slotLines, slotWidth;
    private static int Width(string row)
    {
        int w=0;
        foreach(char c in row) w += c >= 0x2E80 || c is >= '\u3000' and <= '\u303F' || c is >= '\uFF00' and <= '\uFFEF' ? 2 : 1;
        return w;
    }
    private static string Slot(NetworkService s,ulong id,bool local,bool bot)
    {
        string text=s.SlotText(id,local,bot); string[] rows=text.Split('\n');
        slotLines=Math.Max(slotLines,rows.Length); foreach(var row in rows) slotWidth=Math.Max(slotWidth,Width(row));
        Check(rows.Length is >= 1 and <= 6 && rows.All(r=>r.Length>0 && Width(r)<=24) && !text.Contains('<') && !text.Contains('\r'),$"slot shape: {text}");
        return text;
    }
    private static void Slots()
    {
        // Local slot owns the process P2P counters; a BOT has no link of its own and never gets 0 ms.
        var solo=new World(); solo.Members=new ulong[]{1}; var only=solo.Add(1); solo.Run(30,_=>true);
        string self=Slot(only.Service,1,true,false);
        Check(self.StartsWith("本机 · P2P\n") && self.Contains("收 60 KiB/s") && self.Contains("发 120 KiB/s") &&
            self.Contains("采样 #30 · 0.98 秒前") && !self.Contains("往返") &&
            self.Contains("无共享真人"),"local slot: own process P2P receive/send with units, advancing sample stamp, no peer link");
        const string missing="延迟 -- 抖动 -- 丢包 --";
        Check(self.Contains(missing) && Slot(only.Service,1,false,false)==self,"solo lobby keeps all three link metrics and real throughput");
        only.Service.Reset(); Check(Slot(only.Service,1,true,false).Contains(missing),"solo placeholders also exist before roster confirmation");
        string bot=Slot(only.Service,2,false,true);
        Check(bot=="BOT · 网络\n无独立网络连接\n"+missing && !bot.Contains('0'),"BOT shows three unavailable metrics, not fabricated measurements");
        Check(Slot(only.Service,0,true,true)==bot && Slot(only.Service,1,true,true)==bot && Slot(only.Service,0,false,false).StartsWith("队友\n"),"bot takes precedence over zero/self ID and local ownership; unknown remote is not self");
        var team=new World(); for(ulong i=1;i<=4;i++) team.Add(i); team.Run(60,_=>true);
        Check(Slot(team.Clients[1].Service,2,false,true)==bot,"bot slot identical next to a live roster");
        Check(Slot(team.Clients[1].Service,3,false,true)==bot,"bot slot never inherits the peer that shares its id");
        // Unconfirmed: a roster member without a shared report keeps a labelled source and no probe numbers.
        var pending=new World(); var host=pending.Add(1); pending.Run(30,_=>true);
        string pendingText=Slot(host.Service,2,false,false);
        Check(pendingText.StartsWith("队友\n本机→游戏估值\n") && pendingText.Contains("（估）") &&
            pendingText.Contains("波动/探针缺失 未知") && pendingText.EndsWith("未确认，仅游戏内估值"),"unconfirmed peer: estimate source labelled, no probe claim");
        pending.Clients[1].Blind=true; pending.Run(45,_=>true);
        Check(Slot(host.Service,2,false,false)=="队友\n本机→未测得\n往返 未知\n未确认，无共享报告","unreachable peer: unknown, never 0 ms");
        // Confirmed: fresh report plus own probe give the local->peer range, jitter and both loss directions.
        var live=new World(); for(ulong i=1;i<=4;i++) live.Add(i); live.Run(60,_=>true);
        var c1=live.Clients[1].Service;
        string p2=Slot(c1,2,false,false);
        Check(p2.StartsWith("队友\n本机→直连探针\n往返 0–") && p2.Contains("波动 ") && p2.Contains("缺收 ") && p2.Contains("　缺发 ") &&
            !p2.Contains("未确认") && p2.Split('\n').Length==5,"confirmed peer: probe range, application variation, per-direction probe loss");
        Check(Slot(c1,3,false,false).StartsWith("队友\n本机→中继探针\n往返 0–"),"relay link keeps its own direction label");
        // Direction: a peer's own report about a third player is that observer's view, never this slot's numbers.
        live.Clients[2].On=false; live.Run(61,_=>true); // advance the server clock past player 2's last report
        Check(NetworkWire.Decode(live.Data[2],new NetworkRoster(new(live.Lobby,live.Session,1),live.Members,live.Clock),2,out var real2),"read player 2's own epoch");
        live.Data[2]=NetworkWire.Encode(new NetworkScope(live.Lobby,live.Session,2),
            new NetworkReport(real2.Epoch,live.Clock,2097152,4194304,new[]{new NetworkEdge(3,1,999,500,0,0)}));
        live.Run(62,_=>true);
        string remoteView=string.Join("|",c1.Lines(2,i=>$"P{i}"));
        Check(remoteView.Contains("1000") && remoteView.Contains("2048"),"injected report is visible only from that observer");
        string p3=Slot(c1,3,false,false);
        Check(p3.Contains("本机→中继探针") && !p3.Contains("999") && !p3.Contains("1000"),"slot for player 3 ignores player 2's distance to it");
        string of2=Slot(c1,2,false,false);
        Check(!of2.Contains("2048") && !of2.Contains("4096") && of2.Contains("本机→"),"slot for player 2 ignores its self-reported rates");
        // Removal and replacement: no carried-over numbers, no leftover cache entry.
        live.Members=new ulong[]{1,3,4}; live.Run(63,_=>true);
        Check(Slot(c1,2,false,false)=="队友\n网络名单未确认\n无链路数据","departed player keeps no cached numbers");
        live.Add(5); live.Members=new ulong[]{1,3,4,5}; live.Run(64,_=>true);
        string p5=Slot(c1,5,false,false);
        Check(p5.StartsWith("队友\n本机→游戏估值\n往返 ") && !p5.Contains("0–") && p5.EndsWith("未确认，仅游戏内估值"),"replacement player starts unmeasured");
        Console.WriteLine($"slot cards: maxLines={slotLines}, maxWidth={slotWidth} (columns, CJK=2)");
    }
    private static void Sampling()
    {
        // A 1 Hz sampler must be visible as a progression: sequence, real window, sub-second age.
        var solo=new World(); solo.Members=new ulong[]{1}; var only=solo.Add(1); solo.Run(30,_=>true);
        string mid=Slot(only.Service,1,true,false);
        Check(mid.Contains("采样 #30 · 0.98 秒前"),$"mid-window age keeps two decimals instead of a whole 0: {mid}");
        string panel=string.Join("|",only.Service.Lines(1,_=>"P"));
        Check(panel.Contains("本机流量（进程 P2P 载荷，不含本探针，采样 #30（窗 1.0 秒）· 0.98 秒前）"),$"panel stamp carries sequence, window and age: {panel}");
        solo.Run(31,_=>true);
        Check(Slot(only.Service,1,true,false).Contains("采样 #31 · 0.98 秒前"),"next sample increments the sequence");
        solo.Run(33,_=>true);
        Check(Slot(only.Service,1,true,false).Contains("采样 #33 · ") && string.Join("|",only.Service.Lines(1,_=>"P")).Contains("采样 #33（窗 1.0 秒）"),"sampling keeps advancing");
        // Closed panel samples every 5 s: the stamp reports that real window, not an assumed 1 s.
        var shut=new World(); shut.Members=new ulong[]{1}; var quiet=shut.Add(1); shut.Run(12,_=>false);
        Check(Slot(quiet.Service,1,true,false).Contains("采样 #3 · 1.98 秒前") &&
            string.Join("|",quiet.Service.Lines(1,_=>"P")).Contains("采样 #3（窗 5.0 秒）"),"closed window follows the 5 s cadence");
    }
    private static void Coverage()
    {
        // Four states stay distinct: no peer, no baseline, unobservable payload, and a measured zero.
        var w=new World(); w.Members=new ulong[]{1}; var alone=w.Add(1); w.Run(20,_=>true);
        string solo=Slot(alone.Service,1,true,false);
        Check(solo.Contains("无共享真人") && solo.Contains("延迟 --") && solo.Contains("采样 #20 · "),"no peer: placeholders and a live sample, no invented link");
        var o=new World(); o.Members=new ulong[]{1,2}; var host=o.Add(1); var peer=o.Add(2);
        host.Opaque=true; peer.Opaque=true; o.Run(20,_=>true);
        string opaque=Slot(host.Service,1,true,false);
        Check(opaque.Contains("收 未知\n发 未知") && opaque.Contains("计数未确认") && !opaque.Contains("0 KiB/s"),
            $"unobservable payload is never rendered as zero traffic: {opaque}");
        string opaquePanel=string.Join("|",host.Service.Lines(1,_=>"P"));
        Check(opaquePanel.Contains("接收 未知　发送 未知") && opaquePanel.Contains("尚未确认有效载荷回调"),
            "the panel states the coverage instead of claiming idle traffic");
        Check(NetworkWire.Decode(o.Data[1],new NetworkRoster(new(o.Lobby,o.Session,2),o.Members,o.Clock),1,out var unknownRates) &&
            unknownRates.InRate==-1 && unknownRates.OutRate==-1,"an unobservable peer publishes unknown rates, not zero");
        host.Opaque=false; host.Frozen=true; o.Run(23,_=>true);
        Check(Slot(host.Service,1,true,false).Contains("收 0 KiB/s\n发 0 KiB/s"),"a genuine measured zero stays a number");
        host.Frozen=false; host.Trickle=true; o.Run(25,_=>true);
        Check(Slot(host.Service,1,true,false).Contains("收 10 B/s\n发 10 B/s"),"a tiny non-zero rate keeps its own unit instead of 0");
        // A blind process meter with a working host meter: a separate reading that names the interface.
        var fb=new World(); fb.Members=new ulong[]{1,2}; var me=fb.Add(1); var other=fb.Add(2);
        me.Opaque=true; other.Opaque=true; me.Host=true; other.Host=true;
        fb.Run(10,_=>true);
        string fbCard=Slot(me.Service,1,true,false);
        Check(fbCard.StartsWith("整机网卡 · 非 P2P\n收 ") && fbCard.Contains("游戏计数未确认"),
            $"host fallback is labelled on the card and never impersonates the process meter: {fbCard}");
        string fbPanel=string.Join("|",me.Service.Lines(1,_=>"P"));
        Check(fbPanel.Contains("统计范围：未确认 P2P 载荷回调；主机网卡（非 P2P，整机全部进程）接收 ") &&
            fbPanel.Contains("来源：本机主机网卡（非 P2P）") && me.HostPolls>0,
            "panel states the interface meter and its scope instead of calling it P2P");
        Check(NetworkWire.Decode(fb.Data[1],new NetworkRoster(new(fb.Lobby,fb.Session,2),fb.Members,fb.Clock),1,out var hostOnly) &&
            hostOnly.InRate==-1 && hostOnly.OutRate==-1,"a host meter is never published as a link rate");
        // No baseline, a measured zero and a real sub-KiB/s flow remain three different readings.
        var nb=new World(); nb.Members=new ulong[]{1}; var fresh=nb.Add(1); fresh.Opaque=true; fresh.Host=true; nb.Run(1,_=>true);
        Check(Slot(fresh.Service,1,true,false).Contains("网卡待采样"),"a host meter without a baseline is not a zero");
        fresh.HostZero=true; nb.Run(3,_=>true);
        Check(Slot(fresh.Service,1,true,false).Contains("整机网卡 · 非 P2P\n收 0 KiB/s\n发 0 KiB/s") &&
            string.Join("|",fresh.Service.Lines(1,_=>"P")).Contains("主机网卡（非 P2P，整机全部进程）接收 0 KiB/s　发送 0 KiB/s"),
            "a measured host zero stays a number on its own meter");
        fresh.HostZero=false; fresh.HostTrickle=true; nb.Run(5,_=>true);
        Check(Slot(fresh.Service,1,true,false).Contains("整机网卡 · 非 P2P\n收 600 B/s\n发 1.2 KiB/s") &&
            string.Join("|",fresh.Service.Lines(1,_=>"P")).Contains("接收 <1 KiB/s　发送 1.2 KiB/s"),
            "a small host flow keeps B/s and sub-KiB labels instead of rounding to 0");
        // A meter switch restarts that meter's own baseline: totals from two meters never subtract.
        var sw=new World(); sw.Members=new ulong[]{1}; var single=sw.Add(1); sw.Run(10,_=>true);
        Check(Slot(single.Service,1,true,false).Contains("收 60 KiB/s"),"process meter first");
        single.Opaque=true; single.Host=true; sw.Run(11,_=>true);
        string switched=Slot(single.Service,1,true,false);
        Check(switched.Contains("收 未知") && switched.Contains("网卡待采样"),"meter switch restarts the host baseline");
        // The game's own transport meter names itself and needs no interface fallback.
        var gp=new World(); gp.Members=new ulong[]{1}; var gonly=gp.Add(1); gonly.Game=true; gp.Run(10,_=>true);
        string gamePanel=string.Join("|",gonly.Service.Lines(1,_=>"P"));
        Check(gamePanel.Contains("本机流量（游戏传输载荷，不含本探针") && gamePanel.Contains("来源：本机游戏传输") &&
            gamePanel.Contains("同大厅其他真人：无") && gonly.HostPolls==0,
            "game transport meter is named, states an empty roster and needs no fallback");
        var meter=new PayloadMeter(); var s=new NetworkTotal(100,200,NetworkSource.Steam); var g=new NetworkTotal(300,400,NetworkSource.Game);
        meter.Reset(s,g); Check(meter.Sample(s,g).Source==NetworkSource.None,"old lobby totals do not establish coverage");
        s=s with {Tx=240}; Check(meter.Sample(s,g)==new NetworkTotal(-1,240,NetworkSource.Steam),"one observed send does not establish receive coverage");
        g=g with {Rx=301}; Check(meter.Sample(s,g)==new NetworkTotal(301,-1,NetworkSource.Game),"stalled Steam does not mask live game bytes");
        Check(meter.Sample(s,g)==new NetworkTotal(301,-1,NetworkSource.Game),"idle confirmed source remains selected");
    }
    public static void Main()
    {
        foreach(int missing in new[]{-1,0,10001,int.MaxValue}) Check(NetworkLink.CachedEstimate(missing)==(0,-1),"invalid join ping remains unknown");
        Check(NetworkLink.CachedEstimate(1)==(6,1) && NetworkLink.CachedEstimate(10000)==(6,10000),"both boundaries are game estimates only");
        var w=new World(); w.Members=new ulong[]{1}; var client=w.Add(1); w.Run(1,_=>true);
        w.Members=new ulong[]{1,2}; client.GamePing=0; w.Run(2,_=>true);
        Check(Slot(client.Service,2,false,false).Contains("往返 未知") && client.Pulses==0,"unconfirmed join: no synthetic zero or outgoing probe");
        client.GamePing=44; w.Run(3,_=>true);
        Check(Slot(client.Service,2,false,false).Contains("往返 44 ms（估）") && client.Pulses==0,"cached game ping after join, no Messages session or probe");
        client.GamePing=-1; w.Run(4,_=>true); Check(Slot(client.Service,2,false,false).Contains("往返 未知"),"loss of estimate is not last known RTT");
        Console.WriteLine("PASS unconfirmed peer joins: unknown -> 44ms game estimate -> unknown; no probes");
        Budget("open",4); Budget("closed",4); Budget("mixed",2); Budget("closed",1); Rejection(); WireAndMath(); Slots(); Sampling(); Coverage();
        Console.WriteLine("PASS NetworkGate");
    }
}
